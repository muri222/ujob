# Painel (PocketBase). No docker o scout fala com http://panel:8090
PANEL_URL=http://127.0.0.1:8095

# Conta de serviço do scout: só manda vagas, não lê candidaturas
# Gere a senha com: python -c "import secrets; print(secrets.token_urlsafe(24))"
SCOUT_EMAIL=scout@ujob.local
SCOUT_PASSWORD=

# Conta de serviço do brain: só pega e devolve tarefas de IA
BRAIN_EMAIL=brain@radar.local
BRAIN_PASSWORD=

# Ritmo da coleta
SCOUT_LOOP_MINUTES=15
SCOUT_SEARCH_LANES=3
SCOUT_DETAIL_BUDGET=400
SCOUT_LOG_LEVEL=INFO

# Vaga some da fonte por esse tempo e vira "encerrada"
JOB_STALE_HOURS=96
# Encerradas ficam guardadas esse tanto de dias (as que estão no funil nunca somem)
JOB_RETENTION_DAYS=120

# Fontes opcionais com chave (deixe vazio pra pular)
GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=

# Produção (Caddy)
PANEL_DOMAIN=painel.ujob.com.br
ACME_EMAIL=
# IPs que podem abrir o painel (separados por espaço). 0.0.0.0/0 ::/0 libera geral.
PANEL_ALLOWED_IPS="0.0.0.0/0 ::/0"

# 1 reabre o painel cru do PocketBase em /_/ (só pra manutenção)
PB_DASHBOARD=0
