{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uJob",
  "version": "1.1.6",
  "identifier": "com.murillo.radar",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "python stage.py"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Murillo Cunha",
    "shortDescription": "uJob: vagas, candidaturas e leads com IA, tudo no seu PC",
    "resources": {
      "payload/app/": "app/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}